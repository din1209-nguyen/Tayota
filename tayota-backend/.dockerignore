# Ignore generated build outputs so Docker context stays small (gpt)
**/target/

# Ignore persistent container volumes; they should not be sent to docker build (gpt)
docker-data/

# Ignore local IDE metadata that is not needed inside images (gpt)
.idea/

# Ignore local Maven wrapper/cache artifacts from host builds (gpt)
.m2/
.tools/

# Ignore log files generated during local runs (gpt)
*.log
