# Gateway
API_GATEWAY_PORT=9090
FRONTEND_ORIGINS=http://localhost:3000

# Operation service
OPERATION_SERVICE_HOST=operation-service
OPERATION_SERVICE_PORT=8091

# AI service
AI_SERVICE_HOST=ai-service
AI_SERVICE_PORT=8094
FRONTEND_BASE_URL=http://localhost:3000
CATALOG_API_BASE_URL=http://localhost:9090/car
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
QDRANT_API_KEY=
COLLECTION=atbm_httt
SESSION_TTL_SECS=3600

# Databases/cache
POSTGRES_USER=tayota
POSTGRES_PASSWORD=123456
POSTGRES_OPERATION_DB=tayota_operation_db
MONGO_USER=tayota
MONGO_PASSWORD=123456
MONGO_AI_DB=tayota_ai_db
REDIS_HOST=redis
REDIS_PORT=6379

# Auth/JWT
JWT_SECRET=change-me-to-a-long-random-secret
GATEWAY_INTERNAL_SECRET=change-me-gateway-internal-secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CSRF_REQUIRED=false

# Cookie/session
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
AI_CHAT_SESSION_TTL_SECONDS=21600

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Appointment/review jobs
APPOINTMENT_BUSINESS_ZONE=Asia/Bangkok
APPOINTMENT_USER_DAILY_LIMIT=5
APPOINTMENT_GUEST_DAILY_LIMIT=3
APPOINTMENT_USER_COOLDOWN=60s
APPOINTMENT_GUEST_COOLDOWN=120s
APPOINTMENT_MINIMUM_NOTICE=12h
APPOINTMENT_EXPIRATION_CRON=0 10 0 * * *
REVIEW_LINK_BASE_URL=http://localhost:3000/reviews
REVIEW_EXPIRATION_CRON=0 20 0 * * *
