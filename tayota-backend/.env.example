# PostgreSQL username shared by service databases in local Docker runs (gpt)
POSTGRES_USER=tayota

# PostgreSQL password shared by service databases in local Docker runs (gpt)
POSTGRES_PASSWORD=tayota_password

# User service database name used by postgres-user-service (gpt)
POSTGRES_USER_DB=tayota_user_db

# Car service database name used by postgres-car-service (gpt)
POSTGRES_CAR_DB=tayota_car_db

# Operation service database name used by postgres-operation-service (gpt)
POSTGRES_OPERATION_DB=tayota_operation_db

# API Gateway public port on the host machine (gpt)
API_GATEWAY_PORT=8090

# User service internal port used by gateway routing (gpt)
USER_SERVICE_PORT=8091

# Car service internal port used by gateway routing (gpt)
CAR_SERVICE_PORT=8092

# Kafka bootstrap servers used by async event producers
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Operation service internal port used by gateway routing (gpt)
OPERATION_SERVICE_PORT=8093

# Redis hostname inside the docker compose network (gpt)
REDIS_HOST=redis

# Redis port inside the docker compose network (gpt)
REDIS_PORT=6379

# JWT signing secret for local development only; replace outside local dev (gpt)
JWT_SECRET=local_dev_jwt_secret_change_me_32_chars_minimum

# Access token expiration used by user-service, in milliseconds when the app expects millis (gpt)
JWT_ACCESS_TOKEN_EXPIRATION=900000

# Refresh token expiration used by user-service, in milliseconds when the app expects millis (gpt)
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Cookie secure flag for local HTTP development (gpt)
COOKIE_SECURE=false

# gRPC port exposed internally by operation-service notification server (gpt)
NOTIFICATION_SERVICE_GRPC_PORT=8193

# SMTP host used by operation-service email sending (gpt)
MAIL_HOST=smtp.gmail.com

# SMTP port used by operation-service email sending (gpt)
MAIL_PORT=587

# SMTP username placeholder for operation-service email sending (gpt)
MAIL_USERNAME=

# SMTP password placeholder for operation-service email sending (gpt)
MAIL_PASSWORD=
